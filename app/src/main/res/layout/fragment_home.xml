<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".ui.home.HomeFragment">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="1.0"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.0">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/textView4"
                android:layout_width="212dp"
                android:layout_height="0dp"
                android:layout_marginTop="40dp"
                android:text="@string/bienvenida"
                android:textColor="#8F8E8E"
                android:textSize="14sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.155"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/txtnombre"
                android:layout_width="241dp"
                android:layout_height="39dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:text="Pedro Andrade"
                android:textColor="@android:color/black"
                android:textSize="22sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.176"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/textView4" />

            <androidx.cardview.widget.CardView
                android:id="@+id/idcardveterinaria"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/idcardbares"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/veterinaria" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/idcardbelleza"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/idcardrestaurente"
                app:layout_constraintEnd_toStartOf="@+id/idcardhoteles"
                app:layout_constraintStart_toEndOf="@+id/idcardveterinaria">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/belleza" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/idcardhoteles"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="10dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/idcarddeporte"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/belleza" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/idcardbares"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginStart="30dp"
                android:layout_marginBottom="60dp"
                android:elevation="@dimen/m_15dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/carouselRecyclerview"
                app:layout_constraintStart_toStartOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/barespubs" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/idcardrestaurente"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginStart="13dp"
                android:layout_marginEnd="13dp"
                android:layout_marginBottom="60dp"
                android:elevation="@dimen/m_15dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/carouselRecyclerview"
                app:layout_constraintEnd_toStartOf="@+id/idcarddeporte"
                app:layout_constraintStart_toEndOf="@+id/idcardbares">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/restaurantes" />


                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <androidx.cardview.widget.CardView
                android:id="@+id/idcarddeporte"
                android:layout_width="105dp"
                android:layout_height="100dp"
                android:layout_marginEnd="30dp"
                android:layout_marginBottom="60dp"
                android:elevation="@dimen/m_15dp"
                app:cardCornerRadius="@dimen/m_10dp"
                app:cardElevation="@dimen/m_5dp"
                app:layout_constraintBottom_toTopOf="@+id/carouselRecyclerview"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@color/vinonew"
                    android:gravity="center"
                    android:orientation="vertical"
                    tools:ignore="UseCompoundDrawables">


                    <ImageView
                        android:layout_width="wrap_content"
                        android:layout_height="90dp"
                        android:layout_gravity="center"
                        android:contentDescription="@string/str_imagenesdescription"
                        android:src="@drawable/deportes" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <com.jackandphantom.carouselrecyclerview.CarouselRecyclerview
                android:id="@+id/carouselRecyclerview"
                android:layout_width="340dp"
                android:layout_height="191dp"
                android:layout_marginStart="20dp"
                android:layout_marginTop="450dp"
                android:layout_marginEnd="20dp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/imageView5"
                android:layout_width="92dp"
                android:layout_height="61dp"
                android:layout_gravity="left"
                android:layout_marginStart="35dp"
                android:layout_marginTop="40dp"
                android:layout_marginEnd="36dp"
                android:contentDescription="@string/str_imagenesdescription"
                android:src="@drawable/perfil"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.937"
                app:layout_constraintStart_toEndOf="@+id/txtnombre"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>