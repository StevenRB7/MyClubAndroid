<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemcupon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:backgroundTint="@color/white"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:background="@color/white"
        android:backgroundTint="@color/white"
        android:id="@+id/IdbtnCoupon"
        android:layout_width="match_parent"
        android:layout_height="201dp"
        android:clickable="true"
        android:focusable="true"
        app:cardCornerRadius="@dimen/m_15dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/CardBackground"
            android:layout_width="370dp"
            android:layout_marginTop="@dimen/m_15dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/membresiablue"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtDescripcionCupon"
                android:layout_width="383dp"
                android:layout_height="28dp"
                android:layout_marginTop="16dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.06"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtIdCupon" />

            <TextView
                android:id="@+id/txtIdCupon"
                android:layout_width="202dp"
                android:layout_height="28dp"
                android:layout_marginStart="35dp"
                android:layout_marginTop="52dp"
                android:layout_marginEnd="36dp"
                android:layout_marginBottom="1dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.504"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="1.0" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/idbtnverdetalle"
                android:layout_width="125dp"
                android:layout_height="37dp"
                android:layout_marginStart="136dp"
                android:layout_marginTop="17dp"
                android:textSize="10dp"
                android:backgroundTint="#FFFFFF"
                app:cornerRadius="@dimen/m_62dp"
                android:text="VER CUPONES"
                android:textColor="@color/black"
                android:layout_marginEnd="135dp"
                android:layout_marginBottom="16dp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"

                >

            </com.google.android.material.button.MaterialButton>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>