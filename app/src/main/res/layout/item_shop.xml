<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemcupon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/idshop"
        android:layout_width="367dp"
        android:layout_height="182dp"
        android:clickable="true"
        android:layout_marginTop="@dimen/m_8dp"
        android:focusable="true"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="358dp"
            android:layout_height="150dp"
            android:layout_gravity="center"
            android:background="@drawable/vaucherfinal"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtshopdescripcion"
                android:layout_width="156dp"
                android:layout_height="29dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtshopdireccion"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.933" />

            <TextView
                android:id="@+id/txtshopdireccion"
                android:layout_width="137dp"
                android:layout_height="21dp"
                android:layout_marginBottom="16dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/black"
                android:textSize="10sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txtshopdescripcion"
                app:layout_constraintHorizontal_bias="1.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView8" />

            <TextView
                android:id="@+id/txtshopciudad"
                android:layout_width="154dp"
                android:layout_height="30dp"
                android:layout_marginTop="21dp"
                android:layout_marginEnd="27dp"
                android:layout_marginBottom="17dp"
                android:layout_weight="1"
                android:text=""
                android:visibility="gone"
                android:textColor="@color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtshopdescripcion"
                app:layout_constraintTop_toBottomOf="@+id/txtshopdireccion" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="135dp"
                android:layout_height="67dp"
                android:layout_marginStart="16dp"

                android:layout_marginTop="19dp"
                android:layout_marginEnd="207dp"
                android:layout_marginBottom="26dp"
                android:src="@drawable/caran"
                app:layout_constraintBottom_toTopOf="@+id/txtshopdireccion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

            <ImageView
                android:id="@+id/imageView9"
                android:layout_width="99dp"
                android:layout_height="61dp"

                android:layout_marginStart="104dp"
                android:layout_marginEnd="4dp"
                android:layout_marginBottom="52dp"
                android:src="@drawable/descuento"
                app:layout_constraintBottom_toTopOf="@+id/txtshopdescripcion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/imageView8"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>