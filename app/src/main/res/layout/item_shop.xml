<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/itemcupon"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <androidx.cardview.widget.CardView
        android:id="@+id/idshop"
        android:layout_width="367dp"
        android:layout_height="182dp"
        android:clickable="true"
        android:layout_marginTop="@dimen/m_8dp"
        android:focusable="true"
        app:cardCornerRadius="30dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="388dp"
            android:layout_height="180dp"
            android:layout_gravity="center"
            android:background="@drawable/fondobtn"
            android:orientation="horizontal">


            <TextView
                android:id="@+id/txtshopdescripcion"
                android:layout_width="156dp"
                android:layout_height="29dp"
                android:layout_marginStart="28dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="23dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@+id/txtshopciudad"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtshopdireccion" />

            <TextView
                android:id="@+id/txtshopdireccion"
                android:layout_width="122dp"
                android:layout_height="25dp"

                android:layout_marginStart="133dp"

                android:layout_marginEnd="133dp"
                android:layout_marginBottom="18dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtshopdescripcion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imageView8" />

            <TextView
                android:id="@+id/txtshopciudad"
                android:layout_width="154dp"
                android:layout_height="30dp"

                android:layout_marginTop="21dp"
                android:layout_marginEnd="27dp"
                android:layout_marginBottom="17dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/white"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@+id/txtshopdescripcion"
                app:layout_constraintTop_toBottomOf="@+id/txtshopdireccion" />

            <ImageView
                android:id="@+id/imageView8"
                android:layout_width="122dp"
                android:layout_height="85dp"

                android:layout_marginStart="133dp"
                android:layout_marginTop="5dp"
                android:layout_marginEnd="133dp"
                android:src="@drawable/caran"
                app:layout_constraintBottom_toTopOf="@+id/txtshopdireccion"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">

            </ImageView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>
</androidx.constraintlayout.widget.ConstraintLayout>