<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/white"
    tools:context=".uiNavBusiness.perfilBusiness.PerfilBusinnesFragment"

    >

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgperfil"
                android:layout_width="100dp"
                android:layout_height="75dp"
                android:layout_marginStart="130dp"
                android:layout_marginTop="6dp"
                android:layout_marginEnd="131dp"
                android:layout_marginBottom="17dp"
                android:src="@drawable/perfilfoto"
                app:layout_constraintBottom_toTopOf="@+id/txtnombreperfil"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.516"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtnombreperfil2">

            </ImageView>

            <TextView
                android:id="@+id/txtnombreperfil"
                android:layout_width="202dp"
                android:layout_height="28dp"
                android:layout_marginStart="104dp"
                android:layout_marginEnd="105dp"
                android:layout_marginBottom="22dp"
                android:layout_weight="1"
                android:text="Pedro Andrade"
                android:gravity="center"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtnombreperfil3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgperfil" />

            <TextView
                android:id="@+id/txtnombreperfil2"
                android:layout_width="202dp"
                android:layout_height="28dp"
                android:layout_marginStart="104dp"
                android:layout_marginTop="16dp"
                android:layout_marginEnd="105dp"
                android:layout_marginBottom="6dp"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Mi Perfil"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/imgperfil"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintVertical_bias="0.0" />

            <TextView
                android:id="@+id/txtnombreperfil3"
                android:layout_width="374dp"
                android:layout_height="28dp"
                android:layout_marginStart="30dp"
                android:layout_marginEnd="16dp"
                android:layout_marginBottom="35dp"
                android:layout_weight="1"
                android:gravity="left"
                android:text="Información básica"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/txtapellidoperfil5"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtnombreperfil" />

            <TextView
                android:id="@+id/informacion"
                android:layout_width="375dp"
                android:layout_height="27dp"
                android:layout_weight="1"
                android:gravity="left"
                android:layout_marginTop="@dimen/m_15dp"
                android:text="Información de contacto"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                app:layout_constraintBottom_toTopOf="@+id/txtapellidoperfil6"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.722"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtcedula"
                app:layout_constraintVertical_bias="1.0" />

            <TextView
                android:id="@+id/txtcorreoelectronico"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="216dp"
                android:layout_marginBottom="12dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtapellidoperfil4"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtapellidoperfil5" />

            <TextView
                android:id="@+id/txtcedula"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="216dp"
                android:layout_marginBottom="71dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtapellidoperfil4" />

            <TextView
                android:id="@+id/txtapellidoperfil4"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="216dp"
                android:layout_marginBottom="8dp"
                android:layout_weight="1"

                android:text="Cedula"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtcedula"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtcorreoelectronico" />

            <TextView
                android:id="@+id/txtapellidoperfil6"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"

                android:layout_marginEnd="215dp"
                android:layout_weight="1"
                android:text="Celular"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtcelular"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/informacion" />

            <TextView
                android:id="@+id/txtapellidoperfil5"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="216dp"
                android:layout_marginBottom="1dp"
                android:layout_weight="1"
                android:text="Correo Electronico"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintBottom_toTopOf="@+id/txtcorreoelectronico"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtnombreperfil3" />

            <TextView
                android:id="@+id/txtcelular"
                android:layout_width="162dp"
                android:layout_height="21dp"
                android:layout_marginStart="34dp"
                android:layout_marginEnd="228dp"
                android:layout_marginBottom="38dp"
                android:layout_weight="1"
                android:text=""
                android:textColor="@android:color/black"
                android:textSize="16sp"
                android:textStyle="bold"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtapellidoperfil6"
                app:layout_constraintVertical_bias="0.0"
                />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btnCambiarContraseñaEmpresa"
                android:layout_width="151dp"
                android:layout_height="32dp"
                android:layout_marginTop="60dp"
                android:layout_marginEnd="48dp"
                android:background="@drawable/botones_fondo"
                android:text="Cambiar Contraseña"
                android:textColor="@color/white"

                android:textSize="10sp"
                app:layout_constraintEnd_toStartOf="@+id/BtnEscanearQR"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/txtcelular" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/BtnEscanearQR"
                android:layout_width="151dp"
                android:layout_height="32dp"
                android:background="@drawable/botones_fondo"
                android:text="Escanear QR"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.64"
                app:layout_constraintStart_toEndOf="@+id/btnCambiarContraseñaEmpresa"
                app:layout_constraintTop_toBottomOf="@+id/txtcelular"
                app:layout_constraintVertical_bias="0.395" />

            <androidx.appcompat.widget.AppCompatButton
                android:id="@+id/btncerrarsesionbusiness"
                android:layout_width="151dp"
                android:layout_height="32dp"
                android:layout_marginStart="130dp"
                android:layout_marginTop="50dp"
                android:layout_marginEnd="130dp"
                android:layout_marginBottom="10dp"
                android:background="@drawable/botones_fondo"
                android:text="@string/cerra"
                android:textColor="@color/white"
                android:textSize="10sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_bias="0.0"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/BtnEscanearQR"
                app:layout_constraintVertical_bias="1.0" />

        </androidx.constraintlayout.widget.ConstraintLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>